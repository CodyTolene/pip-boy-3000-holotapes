{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "moduleDetection": "auto",
    "types": [],
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": false
  },
  "include": [
    "holotapes/**/*.d.ts",
    "holotapes/**/*.ts",
    "types/**/*.d.ts",
    "types/**/*.ts"
  ]
}
