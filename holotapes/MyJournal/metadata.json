{
  "id": "my-journal",
  "name": "My Journal",
  "author": "@Radiomaru7",
  "version": "1.0.0",
  "description": "A quest and note journal with its own T9 predictive keyboard and a 12,000-word dictionary that knows the wasteland.",
  "icon": "storage/MY-JOURNAL.img",
  "previews": ["previews/LIST.png", "previews/KEYBOARD.png"],
  "type": "app",
  "readme": "README.md",
  "storage": [
    {
      "pipboy": "HOLO/MY_JOURNAL/APP.JS",
      "source": "storage/APP.ts"
    },
    {
      "pipboy": "HOLO/MY_JOURNAL/ENTRY.JS",
      "source": "storage/ENTRY.ts"
    },
    {
      "pipboy": "HOLO/MY_JOURNAL/T9.JS",
      "source": "storage/T9.ts"
    },
    {
      "pipboy": "HOLO/MY_JOURNAL/T9DICT.TXT",
      "source": "storage/T9DICT.txt"
    },
    {
      "pipboy": "HOLO/MY_JOURNAL/DATA_HOOK.JS",
      "source": "storage/DATA_HOOK.ts"
    }
  ],
  "storageOptional": []
}
