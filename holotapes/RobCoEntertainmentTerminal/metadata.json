  "previews": [
    "previews/menu.bmp",
    "previews/music.bmp",
    "previews/music-menu.bmp",
    "previews/images.bmp",
    "previews/videos.bmp"
  ],
  "type": "app",
  "readme": "README.md",
  "previousId": "iPip",
  "storage": [
    { "name": "HOLO/RCET/APP.JS", "url": "assets/APP.MIN.JS" },
    { "name": "HOLO/RCET/ENGINE.JS", "url": "assets/ENGINE.MIN.JS" },
    { "name": "HOLO/RCET/IMAGES.JS", "url": "assets/IMAGES.MIN.JS" },
    { "name": "HOLO/RCET/INTRO.JS", "url": "assets/INTRO.MIN.JS" },
    { "name": "HOLO/RCET/MENU.JS", "url": "assets/MENU.MIN.JS" },
    { "name": "HOLO/RCET/MUSIC.JS", "url": "assets/MUSIC.MIN.JS" },
    { "name": "HOLO/RCET/SETTINGS.JS", "url": "assets/SETTINGS.MIN.JS" },
    { "name": "HOLO/RCET/VIDEO.JS", "url": "assets/VIDEO.MIN.JS" }
