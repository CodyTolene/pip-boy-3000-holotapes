  "author": "@CodyTolene @joemto20-tech",
  "version": "2.2.2",
  "description": "A Vault-Tec approved RobCo holotape for playing WAVs from `MUSIC/`, AVI reels from `VIDEOS/`, and images from `IMAGES/`.",
