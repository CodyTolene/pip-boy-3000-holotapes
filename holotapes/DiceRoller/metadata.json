  "storage": [
    { "pipboy": "HOLO/DICE_ROLLER/APP.JS", "source": "storage/APP.ts" },
    {
      "pipboy": "HOLO/DICE_ROLLER/DICE_MENU.JS",
      "source": "storage/DICE_MENU.ts"
    },
    {
      "pipboy": "HOLO/DICE_ROLLER/DICE_ROLL.JS",
